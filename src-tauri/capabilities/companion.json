{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "companion",
  "description": "Window and display control, granted only to the overlay window. The settings window has no business moving the companion directly.",
  "windows": [
    "companion"
  ],
  "permissions": [
    "core:window:allow-set-position",
    "core:window:allow-outer-position",
    "core:window:allow-outer-size",
    "core:window:allow-inner-size",
    "core:window:allow-scale-factor",
    "core:window:allow-current-monitor",
    "core:window:allow-primary-monitor",
    "core:window:allow-available-monitors",
    "core:window:allow-set-always-on-top",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-cursor-position",
    "core:window:allow-set-ignore-cursor-events",
    "core:window:allow-set-focusable",
    "core:window:allow-monitor-from-point",
    "core:window:allow-set-size",
    "core:window:allow-set-resizable",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "core:window:allow-is-visible"
  ]
}
