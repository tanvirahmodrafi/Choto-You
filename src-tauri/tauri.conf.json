{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Choto You",
  "version": "1.0.0",
  "identifier": "com.chotoyou.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "companion",
        "title": "Choto You",
        "url": "index.html",
        "width": 96,
        "height": 96,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      },
      {
        "label": "settings",
        "title": "Choto You Settings",
        "url": "settings.html",
        "width": 760,
        "height": 560,
        "minWidth": 640,
        "minHeight": 480,
        "center": true,
        "resizable": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/avatars/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Original artwork and code",
    "category": "Utility",
    "shortDescription": "Choto You \u2014 a companion that lives on your desktop"
  }
}
